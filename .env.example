# Copy to .env. Next.js loads it on start; restart `docker compose up -d app` after a change.

# nest-ims API as the browser sees it (nest-ims docker-compose publishes it on host port 3001).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# nest-ims API for server-side code (Server Components, Server Functions, Route Handlers).
# docker-compose.yml overrides this with http://host.docker.internal:3001/api inside the container.
API_URL=http://localhost:3001/api
